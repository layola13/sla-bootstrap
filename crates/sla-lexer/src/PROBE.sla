// 阶段 0 可行性探针：用 SLA 表达一个最小词法器切片。
// 目标：证明 Token.Tag 枚举 + 字节扫描 + span 记录 + @test 可编译可执行。
// 这是 EXECUTION_PLAN 阶段 0（lexer 移植）的前置可行性验证。

enum TokenTag {
    Eof,
    Invalid,
    Identifier,
    IntLiteral,
    Plus,
    Minus,
    LParen,
    RParen,
}

struct Loc {
    start: usize,
    end: usize,
}

struct Token {
    tag: TokenTag,
    loc: Loc,
}

fn is_ident_start(c: u8) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn is_digit(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

// 最小 next：只识别 + - ( ) 整数 标识符，其余 invalid；到尾 eof。
fn next(buf: String, index: usize) -> Token {
    let n = buf.len();
    let i = index;
    while i < n {
        let c = buf[i];
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1;
        } else {
            break;
        };
    }
    if i >= n {
        return Token{ tag: TokenTag::Eof, loc: Loc{ start: i, end: i } };
    };
    let start = i;
    let c = buf[i];
    i = i + 1;
    if c == 43 {
        return Token{ tag: TokenTag::Plus, loc: Loc{ start: start, end: i } };
    };
    if c == 45 {
        return Token{ tag: TokenTag::Minus, loc: Loc{ start: start, end: i } };
    };
    if c == 40 {
        return Token{ tag: TokenTag::LParen, loc: Loc{ start: start, end: i } };
    };
    if c == 41 {
        return Token{ tag: TokenTag::RParen, loc: Loc{ start: start, end: i } };
    };
    if is_digit(c) {
        while i < n && is_digit(buf[i]) {
            i = i + 1;
        }
        return Token{ tag: TokenTag::IntLiteral, loc: Loc{ start: start, end: i } };
    };
    if is_ident_start(c) {
        while i < n {
            let d = buf[i];
            if is_digit(d) || is_ident_start(d) {
                i = i + 1;
            } else {
                break;
            };
        }
        return Token{ tag: TokenTag::Identifier, loc: Loc{ start: start, end: i } };
    };
    return Token{ tag: TokenTag::Invalid, loc: Loc{ start: start, end: i } };
}

@test "probe: lexer minimal slices"() {
    let src = "a + 123";
    let t0 = next(src, 0);
    if t0.tag != TokenTag::Identifier { panic(1); };
    let t1 = next(src, t0.loc.end);
    if t1.tag != TokenTag::Plus { panic(2); };
    let t2 = next(src, t1.loc.end);
    if t2.tag != TokenTag::IntLiteral { panic(3); };
    let t3 = next(src, t2.loc.end);
    if t3.tag != TokenTag::Eof { panic(4); };
}
