// 阶段 0 可行性探针：用 SLA 表达一个最小词法器切片。
// 目标：证明 Token.Tag 枚举 + 字节扫描 + span 记录 + 测试可编译可执行。
// 这是 EXECUTION_PLAN 阶段 0（lexer 移植）的前置可行性验证。
// 字节缓冲区用固定数组 [u8; N] + 显式长度（SLA 处理字节的既有惯例，
// 见 demos/rosetta/199_address_sanitizer_asan 与 demos/cxu/04_config）。

enum TokenTag {
    Eof,
    Invalid,
    Identifier,
    IntLiteral,
    Plus,
    Minus,
}

struct Loc {
    start: usize,
    end: usize,
}

struct Token {
    tag: TokenTag,
    loc: Loc,
}

fn is_ident_start(c: u8) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}

fn is_digit(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

// 最小 next：只识别 + - 整数 标识符，其余 invalid；到尾 eof。
fn next(buf: [u8; 16], n: usize, index: usize) -> Token {
    let i = index;
    while i < n && buf[i] == 32 {
        i = i + 1;
    }
    if i >= n {
        return Token{ tag: TokenTag::Eof, loc: Loc{ start: i, end: i } };
    };
    let start = i;
    let c = buf[i];
    i = i + 1;
    if c == 43 {
        return Token{ tag: TokenTag::Plus, loc: Loc{ start: start, end: i } };
    };
    if c == 45 {
        return Token{ tag: TokenTag::Minus, loc: Loc{ start: start, end: i } };
    };
    if is_digit(c) {
        while i < n && is_digit(buf[i]) {
            i = i + 1;
        }
        return Token{ tag: TokenTag::IntLiteral, loc: Loc{ start: start, end: i } };
    };
    if is_ident_start(c) {
        while i < n && (is_digit(buf[i]) || is_ident_start(buf[i])) {
            i = i + 1;
        }
        return Token{ tag: TokenTag::Identifier, loc: Loc{ start: start, end: i } };
    };
    return Token{ tag: TokenTag::Invalid, loc: Loc{ start: start, end: i } };
}

@test "probe: lexer minimal slices"() {
    let src: [u8; 16] = [97u8, 32, 43, 32, 49, 50, 51, 0, 0, 0, 0, 0, 0, 0, 0, 0];
    let t0 = next(src, 7, 0);
    if t0.tag != TokenTag::Identifier {
        panic(1);
    };
    let t1 = next(src, 7, t0.loc.end);
    if t1.tag != TokenTag::Plus {
        panic(2);
    };
    let t2 = next(src, 7, t1.loc.end);
    if t2.tag != TokenTag::IntLiteral {
        panic(3);
    };
    let t3 = next(src, 7, t2.loc.end);
    if t3.tag != TokenTag::Eof {
        panic(4);
    };
}
