// sla-checker / 所有权状态机核心（阶段 1 起点）
//
// 对应 Zig: sa_plugin_sla/src/type_checker.zig 的所有权状态机 + 
// sci/src/common/capability.zig 的 CapabilityMask/TRUTH_TABLE。
// 参考: layola13/sla/crates/sla-checker/src（Rust 版 checker slice）。
//
// 这里先落最小状态机：仿射值的 active/consumed 转移 + 诊断码。
// 全量 checker（表达式类型、借用、宏/extern 契约）按阶段 5 推进。
// 阶段目标：能被 SLA 编译器 check 通过，作为 checker 移植的地基。

// 仿射状态（对齐 capability.zig CapabilityMask 的位）。
const ST_UNAINIT: u16 = 0;
const ST_ACTIVE: u16 = 1;
const ST_LOCKED_READ: u16 = 2;
const ST_LOCKED_MUT: u16 = 4;
const ST_CONSUMED: u16 = 8;

// 诊断码（对齐 trap / TypeError 的稳定命名序号，最小集）。
const DIAG_OK: i32 = 0;
const DIAG_USE_AFTER_MOVE: i32 = 1009;
const DIAG_BORROW_CONFLICT: i32 = 1008;
const DIAG_MEMORY_LEAK: i32 = 1012;

// 状态转移：alloc 一个新值 -> Active。
fn op_alloc() -> u16 {
    return ST_ACTIVE;
}

// 状态转移：move（消费），仅 Active 合法，转 Consumed。
// 返回诊断码；new_state 通过 out 参数语义（这里用结构返回）。
struct MoveResult {
    diag: i32,
    state: u16,
}
fn op_move(s: u16) -> MoveResult {
    if s == ST_ACTIVE {
        return MoveResult{ diag: DIAG_OK, state: ST_CONSUMED };
    };
    if s == ST_CONSUMED {
        return MoveResult{ diag: DIAG_USE_AFTER_MOVE, state: s };
    };
    if s == ST_LOCKED_READ || s == ST_LOCKED_MUT {
        return MoveResult{ diag: DIAG_BORROW_CONFLICT, state: s };
    };
    return MoveResult{ diag: DIAG_USE_AFTER_MOVE, state: s };
}

// 借用检查：对 Active 或 Locked_Read 加共享借用；Locked_Mut 冲突。
fn op_borrow_read(s: u16) -> MoveResult {
    if s == ST_ACTIVE {
        return MoveResult{ diag: DIAG_OK, state: ST_LOCKED_READ };
    };
    if s == ST_LOCKED_READ {
        return MoveResult{ diag: DIAG_OK, state: ST_LOCKED_READ };
    };
    return MoveResult{ diag: DIAG_BORROW_CONFLICT, state: s };
}

// 独占借用：仅 Active 合法；已有任何锁冲突。
fn op_borrow_mut(s: u16) -> MoveResult {
    if s == ST_ACTIVE {
        return MoveResult{ diag: DIAG_OK, state: ST_LOCKED_MUT };
    };
    return MoveResult{ diag: DIAG_BORROW_CONFLICT, state: s };
}

@test "checker: move state machine"() {
    let s = op_alloc();
    let r = op_move(s);
    if r.diag != DIAG_OK {
        panic(1);
    };
    if r.state != ST_CONSUMED {
        panic(2);
    };
    // 二次 move 报 UseAfterMove
    let r2 = op_move(r.state);
    if r2.diag != DIAG_USE_AFTER_MOVE {
        panic(3);
    };
}

@test "checker: borrow conflict"() {
    let s = op_alloc();
    let m = op_borrow_mut(s);
    if m.diag != DIAG_OK {
        panic(4);
    };
    let m2 = op_borrow_mut(m.state);
    if m2.diag != DIAG_BORROW_CONFLICT {
        panic(5);
    };
}

// ---- 表达式类型推断（阶段 1 切片，对齐 sla-checker 的 Primitive）----
// 类型 kind（i32 常量）：对齐 Rust Type::Primitive 分类与 Zig PrimType。
const TY_UNKNOWN: i32 = 0;
const TY_BOOL: i32 = 1;
const TY_INT: i32 = 2;
const TY_FLOAT: i32 = 3;
const TY_STRING: i32 = 4;
const TY_PTR: i32 = 5;
const TY_VOID: i32 = 6;

const DIAG_TYPE_MISMATCH: i32 = 1004;

// 字面量 kind -> 类型（对齐 ast.sla 的 LIT_* 常量）。
fn type_of_literal(lit_kind: i32) -> i32 {
    if lit_kind == 0 { return TY_INT; };      // LIT_INT
    if lit_kind == 1 { return TY_FLOAT; };    // LIT_FLOAT
    if lit_kind == 2 { return TY_STRING; };   // LIT_STRING
    if lit_kind == 3 { return TY_BOOL; };     // LIT_BOOL
    return TY_UNKNOWN;
}

// 二元运算结果类型（对齐 type_checker.zig checkBinary 的数值提升规则）。
// op: 0=add 1=sub 2=mul 3=div 4=eq 5=ne 6=lt 7=and 8=or
struct TypeResult {
    diag: i32,
    ty: i32,
}
fn type_binary(op: i32, lhs: i32, rhs: i32) -> TypeResult {
    // 比较运算：同类型可比，结果 bool。
    if op == 4 || op == 5 || op == 6 {
        if lhs == rhs {
            return TypeResult{ diag: DIAG_OK, ty: TY_BOOL };
        };
        return TypeResult{ diag: DIAG_TYPE_MISMATCH, ty: TY_UNKNOWN };
    };
    // 逻辑运算：要求 bool。
    if op == 7 || op == 8 {
        if lhs == TY_BOOL && rhs == TY_BOOL {
            return TypeResult{ diag: DIAG_OK, ty: TY_BOOL };
        };
        return TypeResult{ diag: DIAG_TYPE_MISMATCH, ty: TY_UNKNOWN };
    };
    // 算术运算：同数值类型（int/int 或 float/float）结果同类型。
    if lhs == rhs && (lhs == TY_INT || lhs == TY_FLOAT) {
        return TypeResult{ diag: DIAG_OK, ty: lhs };
    };
    return TypeResult{ diag: DIAG_TYPE_MISMATCH, ty: TY_UNKNOWN };
}

// ---- 调用参数 ABI 能力（对齐 lowering_rules.abiCallArgCapKind）----
// CAP_BY_VALUE / CAP_BORROW / CAP_MOVE（对齐 inst.CapPrefix）。
const CAP_BY_VALUE: i32 = 0;
const CAP_BORROW: i32 = 1;
const CAP_MOVE: i32 = 2;
const CAP_RAW: i32 = 3;

// is_borrow 优先于 is_move（对齐 Zig abiCallArgCapKind 的优先级）。
fn abi_call_arg_cap(is_borrow: bool, is_move: bool) -> i32 {
    if is_borrow {
        return CAP_BORROW;
    };
    if is_move {
        return CAP_MOVE;
    };
    return CAP_BY_VALUE;
}

// 借用释放：Locked_Read -> Active，Locked_Mut 需先解独占；
// 引用计数用 u16（对齐 verifier locks[] 的计数语义，简化为单持有者）。
fn op_release_borrow(s: u16) -> MoveResult {
    if s == ST_LOCKED_READ || s == ST_LOCKED_MUT {
        return MoveResult{ diag: DIAG_OK, state: ST_ACTIVE };
    };
    return MoveResult{ diag: DIAG_BORROW_CONFLICT, state: s };
}

@test "checker: call arg ABI caps"() {
    let c1 = abi_call_arg_cap(true, false);
    if c1 != CAP_BORROW {
        panic(11);
    };
    let c2 = abi_call_arg_cap(false, true);
    if c2 != CAP_MOVE {
        panic(12);
    };
    let c3 = abi_call_arg_cap(false, false);
    if c3 != CAP_BY_VALUE {
        panic(13);
    };
    let rel = op_release_borrow(ST_LOCKED_READ);
    if rel.diag != DIAG_OK || rel.state != ST_ACTIVE {
        panic(14);
    };
}

@test "checker: expression types"() {
    let ti = type_of_literal(0);
    if ti != TY_INT {
        panic(6);
    };
    let tf = type_of_literal(1);
    if tf != TY_FLOAT {
        panic(7);
    };
    let add = type_binary(0, ti, ti);
    if add.diag != DIAG_OK || add.ty != TY_INT {
        panic(8);
    };
    let eq = type_binary(4, ti, ti);
    if eq.diag != DIAG_OK || eq.ty != TY_BOOL {
        panic(9);
    };
    let bad = type_binary(0, ti, tf);
    if bad.diag != DIAG_TYPE_MISMATCH {
        panic(10);
    };
}
