}
struct S_SelectCase {
    call: u64,
    bind_name: u64,
    bind_closed: u64,
    body: u64,
}
struct S_SelectStmt {
    cases: u64,
    default_body: u64,
    timeout_expr: u64,
    timeout_body: u64,
}
struct S_IfExpr {
    cond: u64,
    let_chain: u64,
    then_block: u64,
    else_block: u64,
}
struct S_IfLetCond {
    pattern: u64,
    value: u64,
}
struct S_Case {
    body: u64,
}
struct S_SwitchExpr {
    val: u64,
