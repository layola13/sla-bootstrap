}
struct S_StructLiteralField {
    name: u64,
    value: u64,
}
struct S_StructLiteral {
    ty: u64,
    fields: u64,
    update_expr: u64,
}
struct S_EnumLiteralField {
    name: u64,
    value: u64,
}
struct S_EnumLiteral {
    enum_name: u64,
    variant_name: u64,
    fields: u64,
}
struct S_TupleLiteral {
    elements: u64,
}
struct S_ArrayLiteral {
    elements: u64,
}
struct S_RepeatArrayLiteral {
    value: u64,
    len: usize,
}
struct S_IndexExpr {
    target: u64,
    index: u64,
}
struct S_SliceExpr {
    target: u64,
    start: u64,
    end: u64,
}
struct S_TryExpr {
    expr: u64,
}
struct S_UserDefined {
    name: u64,
    generics: u64,
}
struct S_ArrayType {
    elem: u64,
    len: usize,
}
struct S_TupleType {
    elems: u64,
}
struct S_ClosureType {
    params: u64,
    ret: u64,
}
struct S_FnPtrType {
    abi: u64,
    params: u64,
    ret: u64,
    is_variadic: bool,
}

// ---- 常用 payload struct（按 Zig ast.zig 同名字段化简）----

// FuncDecl 的核心字段（ast.zig:FuncDecl）。递归引用用节点 id（arena 索引）。
struct FuncDecl {
    name: String,
    body: usize,
    params: usize,
    ret_ty: usize,
}

// StructDecl：字段列表 id + 名字。
struct StructDecl {
    name: String,
    fields: usize,
}

// LetStmt：名字 + 初始化表达式节点 id + 可选类型 id。
struct LetStmt {
    name: String,
    value: usize,
    ty: usize,
}

// CallExpr：callee 名字 + 实参列表 id。
struct CallExpr {
    callee: String,
    args: usize,
}

// BinaryExpr：op id + 左右操作数节点 id。
struct BinaryExpr {
    op: i32,
    left: usize,
    right: usize,
}

// 字面量的种类（i32 常量）与载荷。
const LIT_INT: i32 = 0;
const LIT_FLOAT: i32 = 1;
const LIT_STRING: i32 = 2;
const LIT_BOOL: i32 = 3;
struct Literal {
    kind: i32,
    text: String,
}

// ---- 统一 Node ----
// tag 决定哪个 slot 有效；无效 slot 置 0。payload 采用「名字+节点id」
// 的通用形态，避免为 58 种变体各开一个字段（阶段 1 定型时按 usage 增补）。
struct Node {
    tag: i32,
    span: Span,
    // 通用 payload 槽：name 是字符串池 id (u64) + 三个整数 id/值槽，足够承载编译器前端的
    // 递归引用（arena 索引）与标量载荷；扩大在阶段 1 接缝说明里登记。
    name: u64,
    a: usize,
    b: usize,
    c: i32,
}

// 构造辅助：建一个 Node（所有槽显式初始化，避免未初始化寄存器）。
fn make_node(tag: i32, start: usize, end: usize) -> Node {
    return Node{
        tag: tag,
        span: Span{ start: start, end: end },
        name: 0,
        a: 0,
        b: 0,
        c: 0,
    };
}

@test "ast node construction"() {
    let n = make_node(NODE_IDENTIFIER, 0, 3);
    if n.tag != NODE_IDENTIFIER {
        panic(1);
    };
    let lit = make_node(NODE_LITERAL, 4, 5);
    if lit.tag != NODE_LITERAL {
        panic(2);
    };
}
