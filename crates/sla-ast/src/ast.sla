// sla-ast / 统一 AST Node 表示（阶段 1 起点）
//
// 对应 Zig: sa_plugin_sla/src/ast.zig 的 Node union + 各 payload struct。
// 参考: layola13/sla/crates/sla-ast/src/node.rs（Rust 版 enum-with-payload 镜像）。
//
// 表示策略（阶段 0 探针 OBS-1 定形，见 crates/sla-lexer/STAGE0_PROBE.md）：
//   Zig 的 `union(enum)` 用 struct { tag: i32, ...payload slots } 表达，
//   不用 SLA enum 变体比较（实测 E::A==E::A 语义不可靠）。tag 常量用 i32，
//   声明序对齐 Zig Node union（ast.zig:3-61）与 Rust Node enum（node.rs:14-83）。
//   递归类型经 slot 中的整数 id 间接（arena 索引），不直接内嵌 Node——
//   规避递归类型的深 drop 截断面（EXECUTION_PLAN G3 / DS2）。

// ---- Node tag（i32 常量，声明序对齐 Zig Node union）----
const NODE_PROGRAM: i32 = 0;
const NODE_STRUCT_DECL: i32 = 1;
const NODE_ENUM_DECL: i32 = 2;
const NODE_TRAIT_DECL: i32 = 3;
const NODE_IMPL_DECL: i32 = 4;
const NODE_TYPE_ALIAS_DECL: i32 = 5;
const NODE_OVERLOAD_DECL: i32 = 6;
const NODE_FUNC_DECL: i32 = 7;
const NODE_MACRO_DECL: i32 = 8;
const NODE_IMPORT_DECL: i32 = 9;
const NODE_USING_DECL: i32 = 10;
const NODE_TEST_DECL: i32 = 11;
const NODE_SUBLANGUAGE_DECL: i32 = 12;
const NODE_SUBLANGUAGE_REGISTRATION: i32 = 13;
const NODE_CHECK_HOOK_DECL: i32 = 14;
const NODE_LET_STMT: i32 = 15;
const NODE_LET_ELSE_STMT: i32 = 16;
const NODE_LET_DESTRUCTURE_STMT: i32 = 17;
const NODE_CONST_STMT: i32 = 18;
const NODE_VAR_STMT: i32 = 19;
const NODE_ASSIGN_STMT: i32 = 20;
const NODE_BLOCK_STMT: i32 = 21;
const NODE_ARENA_STMT: i32 = 22;
const NODE_EXPR_STMT: i32 = 23;
const NODE_RETURN_STMT: i32 = 24;
const NODE_FOR_STMT: i32 = 25;
const NODE_WHILE_STMT: i32 = 26;
const NODE_BREAK_STMT: i32 = 27;
const NODE_CONTINUE_STMT: i32 = 28;
const NODE_RELEASE_STMT: i32 = 29;
const NODE_DEFER_STMT: i32 = 30;
const NODE_SELECT_STMT: i32 = 31;
const NODE_LITERAL: i32 = 32;
const NODE_IDENTIFIER: i32 = 33;
const NODE_GENERIC_FUNC_REF: i32 = 34;
const NODE_GO_EXPR: i32 = 35;
const NODE_IF_EXPR: i32 = 36;
const NODE_SWITCH_EXPR: i32 = 37;
const NODE_MATCH_EXPR: i32 = 38;
const NODE_UNSAFE_EXPR: i32 = 39;
const NODE_AWAIT_EXPR: i32 = 40;
const NODE_INLINE_ASM_EXPR: i32 = 41;
const NODE_BINARY_EXPR: i32 = 42;
const NODE_CALL_EXPR: i32 = 43;
const NODE_CLOSURE_LITERAL: i32 = 44;
const NODE_BORROW_EXPR: i32 = 45;
const NODE_MOVE_EXPR: i32 = 46;
const NODE_DEREF_EXPR: i32 = 47;
const NODE_CAST_EXPR: i32 = 48;
const NODE_FIELD_EXPR: i32 = 49;
const NODE_STRUCT_LITERAL: i32 = 50;
const NODE_ENUM_LITERAL: i32 = 51;
const NODE_TUPLE_LITERAL: i32 = 52;
const NODE_ARRAY_LITERAL: i32 = 53;
const NODE_REPEAT_ARRAY_LITERAL: i32 = 54;
const NODE_INDEX_EXPR: i32 = 55;
const NODE_SLICE_EXPR: i32 = 56;
const NODE_TRY_EXPR: i32 = 57;

// ---- Span（源码位置，对齐 Rust Loc / Zig 的 source_line 概念）----
struct Span {
    start: usize,
    end: usize,
}

// ---- 全部 84 个 payload struct（S_ 前缀，类型按 arena/intern id 归约）----
struct S_Program {
    decls: u64,
}
struct S_StructDecl {
    name: u64,
    derives: u64,
    generics: u64,
    fields: u64,
    is_union: bool,
    is_opaque: bool,
}
struct S_EnumDecl {
    name: u64,
    generics: u64,
    variants: u64,
}
struct S_EnumVariant {
    name: u64,
    fields: u64,
    discriminant: u64,
}
struct S_ImplDecl {
    trait_name: u64,
    target_ty: u64,
    methods: u64,
}
struct S_TypeAliasDecl {
    name: u64,
    components: u64,
}
struct S_OverloadDecl {
    target_ty: u64,
    methods: u64,
}
struct S_TraitMethod {
    name: u64,
    params: u64,
    ret_ty: u64,
}
struct S_TraitDecl {
    name: u64,
    supertraits: u64,
    methods: u64,
}
struct S_Field {
    name: u64,
    ty: u64,
}
struct S_FuncDecl {
    name: u64,
    is_pub: bool,
    is_extern: bool,
    abi: u64,
    no_mangle: bool,
    is_decl_only: bool,
    generics: u64,
    params: u64,
    ret_ty: u64,
    body: u64,
    is_inline: bool,
    is_async: bool,
    is_arena: bool,
    operator: u64,
    is_variadic: bool,
    ret_fallible_sugar: bool,
    ret_borrow_origin: u64,
}
struct S_Param {
    name: u64,
    ty: u64,
    is_borrow: bool,
    is_move: bool,
    is_fallible_sugar: bool,
}
struct S_MacroDecl {
    name: u64,
    params: u64,
    body: u64,
    param_types: u64,
}
struct S_ImportDecl {
    path: u64,
}
struct S_UsingDecl {
    path: u64,
}
struct S_SublanguageRegistration {
    kind: u64,
}
struct S_SublanguageDecl {
    kind: u64,
    name: u64,
    payload: u64,
}
struct S_ShaderDecl {
    name: u64,
    priority: u64,
    globals: u64,
    inputs: u64,
    params: u64,
    consts: u64,
    vars: u64,
    init: u64,
    vertex: u64,
    fragment: u64,
}
struct S_ShaderGlobalGroup {
    name: u64,
    fields: u64,
}
struct S_ShaderField {
    name: u64,
    ty: u64,
}
struct S_ShaderConst {
    name: u64,
    ty: u64,
    value: u64,
}
struct S_ShaderAssign {
    target: u64,
    value: u64,
}
struct S_ShaderIf {
    cond: u64,
    body: u64,
}
struct S_ShaderMemberAccess {
    base: u64,
    field: u64,
}
struct S_ShaderBinary {
    op: u64,
    lhs: u64,
    rhs: u64,
}
struct S_ShaderUnary {
    op: u64,
    expr: u64,
}
struct S_ShaderConstruct {
    ty: u64,
    args: u64,
}
struct S_ShaderSample {
    tex: u64,
    uv: u64,
}
struct S_ShaderCall {
    name: u64,
    args: u64,
}
struct S_CheckHookDecl {
    name: u64,
}
struct S_TestDecl {
    name: u64,
    is_ignored: bool,
    should_panic: bool,
    body: u64,
}
struct S_LetStmt {
    name: u64,
    ty: u64,
    value: u64,
}
struct S_LetElseStmt {
    pattern: u64,
    value: u64,
    else_block: u64,
}
struct S_LetDestructureStmt {
    names: u64,
    value: u64,
    rest_name: u64,
    rest_alias: u64,
    is_slice: bool,
}
struct S_ConstStmt {
    name: u64,
    ty: u64,
    value: u64,
}
struct S_VarStmt {
    name: u64,
    ty: u64,
}
struct S_AssignStmt {
    target: u64,
    value: u64,
}
struct S_BlockStmt {
    body: u64,
}
struct S_ArenaStmt {
    body: u64,
}
struct S_ReturnStmt {
    value: u64,
}
struct S_ForStmt {
    var_name: u64,
    start: u64,
    end: u64,
    body: u64,
}
struct S_WhileStmt {
    cond: u64,
    let_pattern: u64,
    body: u64,
}
struct S_BreakStmt {
}
struct S_ContinueStmt {
}
struct S_ReleaseStmt {
    var_name: u64,
}
struct S_GoExpr {
    supervised: bool,
